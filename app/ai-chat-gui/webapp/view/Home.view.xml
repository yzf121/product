<?xml version="1.0" encoding="UTF-8"?>
<mvc:View
    controllerName="com.ai.assistant.aichatapp.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    height="100%">
    
    <Page
        id="homePage"
        showHeader="true"
        backgroundDesign="Solid"
        class="sapUiContentPadding homePageBackground">
        <customHeader>
            <Bar>
                <contentLeft>
                    <Image src="images/accenture-logo.png" height="1.5rem" class="sapUiSmallMarginBegin accentureLogo"/>
                    <Title text="{i18n>launchpadTitle}" class="sapUiSmallMarginBegin"/>
                </contentLeft>
                <contentRight>
                    <Button
                        icon="sap-icon://action-settings"
                        type="Transparent"
                        tooltip="{i18n>settings}"
                        press="onSettingsPress"/>
                </contentRight>
            </Bar>
        </customHeader>
        
        <content>
            <MessageStrip
                text="{settings>/statusText}"
                type="{settings>/statusType}"
                visible="{settings>/statusVisible}"
                showIcon="true"
                showCloseButton="false"
                class="sapUiMediumMarginBegin sapUiMediumMarginEnd sapUiMediumMarginTop"/>
            <!-- 欢迎区域 -->
            <VBox class="sapUiMediumMargin welcomeSection" alignItems="Center">
                <Title text="{i18n>welcomeHomeTitle}" level="H1" class="sapUiSmallMarginBottom"/>
                <Text text="{i18n>welcomeHomeSubtitle}" class="subtitleText"/>
            </VBox>
            
            <!-- AI助手分类区域 -->
            <VBox class="sapUiMediumMargin">
                <Title text="{i18n>aiAssistantsCategory}" level="H2" class="sapUiMediumMarginBottom categoryTitle"/>
                
                <HBox wrap="Wrap" class="tileContainer">
                    <!-- ABAP Clean Core 助手 -->
                    <GenericTile
                        header="{i18n>abapCleanCoreTitle}"
                        subheader="{i18n>abapCleanCoreDesc}"
                        press="onTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom aiTile">
                        <TileContent>
                            <ImageContent src="sap-icon://syntax"/>
                        </TileContent>
                        <customData>
                            <core:CustomData key="aiType" value="abap-clean-core"/>
                        </customData>
                    </GenericTile>
                    
                    <!-- CPI 助手 -->
                    <GenericTile
                        header="{i18n>cpiAiTitle}"
                        subheader="{i18n>cpiAiDesc}"
                        press="onTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom aiTile">
                        <TileContent>
                            <ImageContent src="sap-icon://connected"/>
                        </TileContent>
                        <customData>
                            <core:CustomData key="aiType" value="cpi"/>
                        </customData>
                    </GenericTile>
                    
                    <!-- Function Doc 助手 -->
                    <GenericTile
                        header="{i18n>funcDocAiTitle}"
                        subheader="{i18n>funcDocAiDesc}"
                        press="onTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom aiTile">
                        <TileContent>
                            <ImageContent src="sap-icon://document-text"/>
                        </TileContent>
                        <customData>
                            <core:CustomData key="aiType" value="func-doc"/>
                        </customData>
                    </GenericTile>
                    
                    <!-- FSD转TSD助手 - 上下分离设计（使用自定义HTML） -->
                    <core:HTML id="fsd2tsdTile" content="
                        &lt;div class='fsd2tsdWrapper sapUiSmallMarginEnd sapUiSmallMarginBottom'&gt;
                            &lt;div class='fsd2tsdHalf fsd2tsdTop' id='fsd2tsdTileI' role='button' tabindex='0'&gt;
                                &lt;div class='fsd2tsdContent'&gt;
                                    &lt;div class='fsd2tsdText'&gt;
                                        &lt;div class='fsd2tsdTitle'&gt;FSD转TSD（I）&lt;/div&gt;
                                        &lt;div class='fsd2tsdSubtitle'&gt;Implementation&lt;/div&gt;
                                    &lt;/div&gt;
                                    &lt;span class='sapUiIcon fsd2tsdIcon' style='font-family: SAP-icons'&gt;&amp;#xe0ab;&lt;/span&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;
                            &lt;div class='fsd2tsdHalf fsd2tsdBottom' id='fsd2tsdTileE' role='button' tabindex='0'&gt;
                                &lt;div class='fsd2tsdContent'&gt;
                                    &lt;div class='fsd2tsdText'&gt;
                                        &lt;div class='fsd2tsdTitle'&gt;FSD转TSD（E）&lt;/div&gt;
                                        &lt;div class='fsd2tsdSubtitle'&gt;Enhancement&lt;/div&gt;
                                    &lt;/div&gt;
                                    &lt;span class='sapUiIcon fsd2tsdIcon' style='font-family: SAP-icons'&gt;&amp;#xe0ab;&lt;/span&gt;
                                &lt;/div&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                    "/>

                    <!-- Tech Doc 助手 -->
                    <GenericTile
                        header="{i18n>techDocAiTitle}"
                        subheader="{i18n>techDocAiDesc}"
                        press="onTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom aiTile">
                        <TileContent>
                            <ImageContent src="sap-icon://technical-object"/>
                        </TileContent>
                        <customData>
                            <core:CustomData key="aiType" value="tech-doc"/>
                        </customData>
                    </GenericTile>
                </HBox>
            </VBox>
            
            <!-- 工具分类区域 -->
            <VBox class="sapUiMediumMargin">
                <Title text="{i18n>toolsCategory}" level="H2" class="sapUiMediumMarginBottom categoryTitle"/>
                
                <HBox wrap="Wrap" class="tileContainer">
                    <!-- Diagram Helper（流程图生成） -->
                    <GenericTile
                        header="{i18n>diagramHelperTitle}"
                        subheader="{i18n>diagramHelperDesc}"
                        press="onDiagramTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom diagramTile">
                        <TileContent>
                            <ImageContent src="sap-icon://workflow-tasks"/>
                        </TileContent>
                    </GenericTile>
                    
                    <!-- 代码审查 -->
                    <GenericTile
                        header="{i18n>codeReviewTitle}"
                        subheader="{i18n>codeReviewDesc}"
                        press="onTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom toolTile">
                        <TileContent>
                            <ImageContent src="sap-icon://inspect"/>
                        </TileContent>
                        <customData>
                            <core:CustomData key="aiType" value="code-review"/>
                        </customData>
                    </GenericTile>
                    
                    <!-- 单元测试生成 -->
                    <GenericTile
                        header="{i18n>unitTestTitle}"
                        subheader="{i18n>unitTestDesc}"
                        press="onTilePress"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom toolTile">
                        <TileContent>
                            <ImageContent src="sap-icon://checklist-item"/>
                        </TileContent>
                        <customData>
                            <core:CustomData key="aiType" value="unit-test"/>
                        </customData>
                    </GenericTile>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
