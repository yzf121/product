# DashScope API configuration
# Copy this file to `.env` and fill in real values.

# Shared API key (required)
DASHSCOPE_API_KEY=your_api_key_here

# Default app ID (required if assistant-specific IDs are not set)
DASHSCOPE_APP_ID=your_default_app_id_here

# Optional assistant-specific app IDs
DASHSCOPE_APP_ID_ABAP=
DASHSCOPE_APP_ID_CPI=
DASHSCOPE_APP_ID_FUNC_DOC=
DASHSCOPE_APP_ID_FSD2TSD_I=
DASHSCOPE_APP_ID_FSD2TSD_E=
DASHSCOPE_APP_ID_TECH_DOC=
DASHSCOPE_APP_ID_CODE_REVIEW=
DASHSCOPE_APP_ID_UNIT_TEST=
DASHSCOPE_APP_ID_DIAGRAM=

# Optional assistant-specific API keys
DASHSCOPE_API_KEY_FSD2TSD_I=
DASHSCOPE_API_KEY_FSD2TSD_E=

# Optional stream payload guards
CHAT_REQUEST_LIMIT=20mb
CHAT_MESSAGE_MAX_LENGTH=120000
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_SESSION_ID_MAX_LENGTH=256
CHAT_SSE_BUFFER_MAX_LENGTH=1048576
CHAT_UPSTREAM_ERROR_MAX_LENGTH=300
