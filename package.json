{
  "name": "abap-clean-core-ai-fiori-new",
  "version": "1.4.3",
  "description": "AI assistant platform - frontend-only UI5 app",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "npm --workspace app/ai-chat-gui run start",
    "dev": "npm --workspace app/ai-chat-gui run dev",
    "watch-ai-chat-gui": "npm --workspace app/ai-chat-gui run dev",
    "doctor": "node scripts/doctor.js",
    "lint": "npx eslint app/ai-chat-gui/webapp/controller app/ai-chat-gui/webapp/util app/ai-chat-gui/webapp/Component.js --max-warnings=0",
    "verify": "node scripts/verify.js",
    "undeploy": "cf undeploy abap-clean-core-ai-fiori-new --delete-services --delete-service-keys --delete-service-brokers",
    "build:mta": "node scripts/build-mta.js build --mtar archive",
    "build": "rimraf resources mta_archives && npm run build:mta",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
